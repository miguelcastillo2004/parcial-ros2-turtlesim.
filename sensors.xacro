<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= IMU (Unidad de Medición Inercial) ================= -->
  <!-- Representada como una pequeña caja en el centro del robot -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.05" x="0.02" y="0.02" z="0.02" o_xyz="0 0 0" o_rpy="0 0 0"/>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- Se ubica justo encima del centro del chasis -->
    <origin xyz="0 0 ${base_height + 0.01}" rpy="0 0 0"/>
  </joint>

  <!-- ================= LIDAR (Sensor Láser 2D/3D) ================= -->
  <!-- Representado como un cilindro en la parte superior trasera -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.1" r="0.03" h="0.04" o_xyz="0 0 0" o_rpy="0 0 0"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- Retrasado en el eje X y elevado en Z -->
    <origin xyz="-0.05 0 ${base_height + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- ================= CÁMARA ================= -->
  <!-- Representada como una caja rectangular en el frente del robot -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.05 0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.05 0.03"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.05" x="0.02" y="0.05" z="0.03" o_xyz="0 0 0" o_rpy="0 0 0"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- Justo en el borde frontal del chasis -->
    <origin xyz="${base_length/2} 0 ${base_height/2}" rpy="0 0 0"/>
  </joint>

</robot>
